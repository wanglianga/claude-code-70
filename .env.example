# ===== 宿主发布端口（只发布应用 web 服务，内部 nginx 监听 8080）=====
CC_PUBLISH_PORT=3070

# ===== docker compose 项目名（由任务环境固定，勿改）=====
COMPOSE_PROJECT_NAME=task2026-09-1470

# ===== PostgreSQL（仅 compose 内网，不发布到宿主）=====
DB_USER=canteen
DB_PASSWORD=canteen_pwd
DB_NAME=canteen

# ===== 后端 JWT 密钥（生产请更换）=====
JWT_SECRET=canteen-dev-secret-change-me
